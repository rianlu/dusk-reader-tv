# Copy this file to keystore.properties and keep the real file out of git.
# Prefer an absolute keystore path outside the repository.
# For the default PKCS12 keystore, keep key password the same as store password.
BETA_STORE_FILE=/Users/<you>/.local/share/android-keystores/dusk-reader-tv-beta.jks
BETA_STORE_PASSWORD=<store-password>
BETA_KEY_ALIAS=dusk-reader-tv-beta
BETA_KEY_PASSWORD=<store-password>
